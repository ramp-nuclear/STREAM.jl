{
  "format_version": "2.0",
  "model_options": {
    "name": "simple_loop",
    "description": "Phase 62 Resources-architecture smoke example — Pump + ChannelAndContacts + HeatDiffusion closed loop with z_cosine power shape.",
    "default_fluid": "water",
    "g_default": 9.80665,
    "solver": {
      "abstol": 1e-8,
      "reltol": 1e-6,
      "dtmax": null
    }
  },
  "resources": {
    "geometries": [
      {
        "uuid": "g-mtr-channel-uuid",
        "name": "mtr_channel",
        "kind": "rectangular",
        "params": {
          "L": 0.6,
          "W": 0.07,
          "H": 0.0025
        }
      }
    ],
    "power_shapes": [
      {
        "uuid": "ps-axial-cos-uuid",
        "name": "axial_cos",
        "kind": "z_cosine",
        "params": {
          "amplitude": 1.0
        }
      }
    ],
    "fluids": []
  },
  "components": [
    {
      "id": "pump-node",
      "type": "streamNode",
      "position": { "x": 100, "y": 200 },
      "data": {
        "componentId": "Pump",
        "instanceName": "pump_1",
        "parameters": {
          "dP_pump": 30000.0
        },
        "constructorMode": "fixed-dP"
      }
    },
    {
      "id": "cac-node",
      "type": "streamNode",
      "position": { "x": 360, "y": 200 },
      "data": {
        "componentId": "ChannelAndContacts",
        "instanceName": "cac_1",
        "parameters": {
          "n": 5,
          "geometry_ref": "g-mtr-channel-uuid"
        }
      }
    },
    {
      "id": "hd-node",
      "type": "streamNode",
      "position": { "x": 620, "y": 200 },
      "data": {
        "componentId": "HeatDiffusion",
        "instanceName": "hd_1",
        "parameters": {
          "nz": 5,
          "nx": 3,
          "Lz": 0.6,
          "Lx": 0.07,
          "y": 0.0015,
          "rho_s": 6500.0,
          "cp_s": 300.0,
          "k_s": 15.0,
          "power": 1.0e6,
          "T0": 313.15,
          "power_shape_ref": "ps-axial-cos-uuid"
        }
      }
    }
  ],
  "connections": [
    {
      "id": "edge-pump-cac",
      "source": "pump-node",
      "target": "cac-node",
      "sourceHandle": "port_out",
      "targetHandle": "port_in"
    },
    {
      "id": "edge-cac-pump",
      "source": "cac-node",
      "target": "pump-node",
      "sourceHandle": "port_out",
      "targetHandle": "port_in"
    },
    {
      "id": "edge-cac-hd-left",
      "source": "cac-node",
      "target": "hd-node",
      "sourceHandle": "thermal_right",
      "targetHandle": "thermal_left"
    },
    {
      "id": "edge-cac-hd-right",
      "source": "cac-node",
      "target": "hd-node",
      "sourceHandle": "thermal_left",
      "targetHandle": "thermal_right"
    }
  ],
  "bcs": [
    {
      "nodeId": "pump-node",
      "portField": "port_in.P",
      "value": 100000.0
    }
  ],
  "layout": {
    "active_left_tab": "Components",
    "active_layer": "Both"
  }
}
