  "typography": {
    "scale_ratio": 1.25,
    "scale_name":  "Major Third",
    "tokens": {
      "micro":   { "size_px": 10, "line_height_rem": 1,    "use": "Layer headers, validator-id chips, section labels, keyboard chips" },
      "label":   { "size_px": 11, "line_height_rem": 1,    "use": "Status bar chips, node value summary, Badge, Label" },
      "body":    { "size_px": 13, "line_height_rem": 1.25, "use": "Inputs, buttons, menu items, node instance name" },
      "title":   { "size_px": 16, "line_height_rem": 1.5,  "use": "Panel headers, dialog titles" },
      "display": { "size_px": 20, "line_height_rem": 1.75, "use": "Reserved for future major hierarchy moments" }
    },
    "control_text_carveout_px": 12,
    "status_bar_count_carveout_px": 15,
    "font_stack": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, sans-serif",
    "font_decision_status": "TBD — Tailwind default system stack; final pairing deferred"
  },

  "radius": {
    "sm":  "0.25rem",
    "md":  "0.5rem",
    "lg":  "0.625rem",
    "xl":  "calc(0.625rem + 4px)",
    "rules": [
      "compact controls (Button, Input, Badge, menu items) use --radius-sm",
      "surfaces (Dialog, AlertDialog, Sheet, hand-rolled modal bodies) use --radius-md",
      "primitive layer never reaches for rounded-lg / rounded-xl"
    ]
  },

  "shadow": {
    "policy": "single tier",
    "single_tier_token": "--shadow-dialog",
    "applied_to": ["Dialog", "AlertDialog", "Sheet", "UnsavedChangesDialog", "AutoRecoverRestoreModal"],
    "zero_shadow_on": [
      "Popover", "DropdownMenu", "ContextMenu", "Menubar", "Tooltip",
      "Select", "Sonner", "Input", "Textarea", "Checkbox", "RadioGroup",
      "Button", "Toggle", "ToggleGroup", "Badge", "Card", "Tabs",
      "canvas overlay buttons (ZoomIn / ZoomOut / FitView / SnapToGrid / InteractiveLockButton)"
    ]
  },

  "modal": {
    "scrim": "transparent",
    "scrim_banned": ["bg-foreground/40", "bg-black/50", "bg-black/60", "backdrop-blur-*"],
    "surface_token": "--dialog-surface",
    "border_token":  "--dialog-border",
    "shadow_token":  "--shadow-dialog",
    "carveouts": {
      "popover_lifted_chrome_keeps_popover_tone": true
    }
  },

  "motion": {
    "fade_in_ms": 100,
    "fade_out_ms": 80,
    "reactive_state_change": "snap (no transition on box-shadow for cross-panel reactive state)",
    "self_initiated_state_change": "200ms ease on box-shadow (canvas-side selection)",
    "marching_ants_keyframe": "flow-trace-march",
    "marching_ants_uses": {
      "validation-flow-trace": "1.5s linear infinite",
      "code-link-active":      "1.2s linear infinite",
      "anatomy-flow-march":    "scoped to AnatomyDialog"
    },
    "reduce_motion_policy": "Global @media (prefers-reduced-motion: reduce) plus per-class motion-reduce:!duration-0; JS-side scrollIntoViewSafe inline-reads data-motion attribute"
  },

  "severity": {
    "vocabulary": ["error", "warning", "info"],
    "color_var": {
      "error":   "var(--destructive)",
      "warning": "var(--color-warning)",
      "info":    "var(--color-info)"
    },
    "icon": {
      "error":   "lucide.CircleX",
      "warning": "lucide.TriangleAlert",
      "info":    "lucide.Info"
    },
    "label_strategy": {
      "panel":      "full lowercase words",
      "status_bar": "icon only (Status-Bar-Icons-Are-The-IDE-Convention carveout)"
    },
    "source_of_truth": "gui/src/lib/severity.ts"
  },

  "section_header": {
    "vocabulary": "text-micro font-mono uppercase tracking-wide text-foreground/45",
    "component": "gui/src/components/ui/section-header.tsx",
    "tags": ["div", "span", "h2", "h3", "h4"],
    "exception": {
      "AnatomyDialog tile titles": "tracking-wider + text-foreground/55 (dialog-internal, distinct pattern)"
    }
  },

  "layer_taxonomy": {
    "slots": ["Hydraulic", "Thermal", "Sources", "ReactorPhysics"],
    "color_var_map": "gui/src/lib/layerColors.ts (LAYER_COLOR_VAR)",
    "visual_only_map": "gui/src/lib/layers.ts (getDisplayLayers)"
  },

  "shortcuts": {
    "catalog_source": "gui/src/lib/shortcuts.ts (SHORTCUTS_CATALOG)",
    "policy": "Static text affordance; shortcut chips never invoke on click in cmdk shortcut mode"
  },

  "preferences": {
    "storage": "localStorage namespaced per-key (stream-composer-pref.<category>.<setting>)",
    "module":  "gui/src/lib/preferences.ts",
    "categories": ["editor", "appearance", "files", "validation", "codeExport", "advanced"]
  },

  "primitives": {
    "directory": "gui/src/components/ui/",
    "shipped": [
      "alert-dialog", "badge", "button", "checkbox", "command",
      "context-menu", "dialog", "dropdown-menu", "input", "label",
      "menubar", "popover", "radio-group", "scroll-area", "section-header",
      "select", "separator", "sheet", "sonner", "switch", "tabs",
      "textarea", "toggle", "toggle-group", "tooltip"
    ],
    "density_baseline_px": 32,
    "compact_density_px": 28,
    "chip_density_px": 24
  },

  "bans": {
    "absolute": [
      "side-stripe colored borders > 1px",
      "gradient text (background-clip: text + gradient)",
      "glassmorphism / backdrop-blur as default",
      "decorative motion",
      "em dashes (use commas, colons, semicolons, periods, parentheses)",
      "modal scrim (bg-*/N dimming the canvas)",
      "FixAction buttons in inspection panels"
    ],
    "project_specific": [
      "raw Tailwind color classes outside documented carveouts (WindowControls macOS traffic-light hex, close-button red-600 platform mimicry)",
      "arbitrary text-[Npx] outside locked 12px control + 15px status-bar carveouts",
      "consumer-SaaS empty-state hand-holding (\"Save a selection to add your first template.\")",
      "auto-fix buttons in validation surfaces",
      "ambient atmospheric shadows on chrome controls"
    ]
  },

  "carveouts": [
    "WindowControls macOS traffic-light hex values",
    "Close-button red-600 Windows/Linux platform mimicry",
    "Syntax tokens (--syntax-*) consumed only inside CodePreview",
    "Status-bar severity icons (IDE convention)",
    "AnatomyDialog tile titles (distinct from SectionHeader idiom)",
    "Code-link active state uses --foreground (no new hue)",
    "Switch primitive uses rounded-full (pill is the affordance)"
  ]
}
