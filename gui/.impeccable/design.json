{
  "$schema": "https://impeccable.dev/schema/design.v1.json",
  "name": "STREAM Composer",
  "register": "product",
  "version": "phase-72-closed",
  "source_of_truth": "DESIGN.md",
  "generated_at": "2026-05-28",
  "notes": "Machine-readable extract of the Phase 72 locked design system, refreshed 2026-05-28 after the post-72 critique pass closed (38/40 health score). The canonical SSOT for token primitives is the YAML frontmatter at the top of DESIGN.md (Stitch v2 spec); this v1 sidecar mirrors the rich theme + token data and preserves the v1 schema for tooling that depends on it. --dialog-surface / --dialog-border below are historical artifacts; the unified dialog tone is now bg-chrome + border-border (see DESIGN.md §4 Modal Lock).",

  "color_strategy": {
    "canvas": "Full palette — 4 layer accents + 4 functional roles + 5 syntax tokens",
    "chrome": "Restrained — tinted neutrals only; accents appear only as layer dots"
  },

