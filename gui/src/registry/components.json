{
  "stream_version": "1.1.0",
  "schema_version": "2.0",
  "components": [
    {
      "id": "Channel",
      "label": "Channel",
      "category": "Hydraulic",
      "description": "Single-phase convective channel with n axial finite-volume cells. v1.1: per-cell h_left/h_right Properties-tab kwargs (Real | Vector | Function) drive the convective coefficient on each face; T_wall_left[1:n] / T_wall_right[1:n] external-input BCs declare wall temperatures via the BCs tab (Value/Profile/Function/Mark, or a Source dashed-edge from a WallTemperature block). A BCPort target handle (`T_wall_left`) on the bottom edge accepts dashed BC edges from a WallTemperature node; the right-side T_wall_right BC mirrors automatically when bcSymmetric is ON (default).",
      "ports": [
        { "name": "port_in", "type": "FlowPort", "side": "left" },
        { "name": "port_out", "type": "FlowPort", "side": "right" },
        { "name": "T_wall_left", "type": "BCPort", "array_size": "n", "side": "bottom" }
      ],
      "parameters": [
        {
          "name": "n",
          "type": "Int",
          "description": "Number of axial finite-volume cells",
          "required": true,
          "positional": false
        },
        {
          "name": "geometry",
          "type": "PipeGeometry",
          "description": "Pipe geometry descriptor (use PipeGeometry_rectangular or PipeGeometry_circular)",
          "required": true,
          "positional": false
        },
        {
          "name": "g",
          "type": "Real",
          "unit": "m/s^2",
          "default": 0.0,
          "description": "Gravitational acceleration; 0.0 for horizontal, 9.80665 for vertical",
          "required": false,
          "positional": false
        },
        {
          "name": "h_left",
          "type_union": ["Real", "Vector", "Function"],
          "input_modes": ["scalar", "vector", "callable"],
          "unit": "W/(m^2 K)",
          "default": 0.0,
          "description": "Per-cell convective HTC on the left face; scalar broadcasts to n cells, vector length must equal n, callable evaluated as h_left_fn(t)",
          "required": false,
          "positional": false
        },
        {
          "name": "h_right",
          "type_union": ["Real", "Vector", "Function"],
          "input_modes": ["scalar", "vector", "callable"],
          "unit": "W/(m^2 K)",
          "default": 0.0,
          "description": "Per-cell convective HTC on the right face; scalar broadcasts to n cells, vector length must equal n, callable evaluated as h_right_fn(t)",
          "required": false,
          "positional": false
        },
        {
          "name": "friction_correlation",
          "type": "Function",
          "default": "blasius_friction",
          "description": "Friction factor correlation closure (Re) -> f",
          "required": false,
          "positional": false,
          "options": [
            { "value": "blasius_friction", "label": "Blasius", "kind": "stateless" },
            {
              "value": "turbulent_friction",
              "label": "Turbulent (Colebrook-White)",
              "kind": "stateless",
              "sub_parameters": [
                { "name": "epsilon", "type": "Real", "unit": "m", "default": 0.0, "description": "Pipe surface roughness", "required": false, "positional": false }
              ]
            },
            { "value": "laminar_friction", "label": "Laminar", "kind": "factory", "geom_source": "parent" }
          ]
        }
      ],
      "external_inputs": [
        {
          "name": "T_wall_left",
          "shape": "[1:n]",
          "unit": "K",
          "description": "Per-cell left-wall temperature BC",
          "bc_modes": ["Value", "Profile", "Function", "Mark", "Source"],
          "source_component": "WallTemperature",
          "source_port": "T_wall_out"
        },
        {
          "name": "T_wall_right",
          "shape": "[1:n]",
          "unit": "K",
          "description": "Per-cell right-wall temperature BC",
          "bc_modes": ["Value", "Profile", "Function", "Mark", "Source"],
          "source_component": "WallTemperature",
          "source_port": "T_wall_out"
        }
      ],
      "constructorModes": [
        {
          "mode": "default",
          "signature": "Channel(; n, geometry, g=0.0, h_left=0.0, h_right=0.0, friction_correlation=blasius_friction)",
          "parameters": ["n", "geometry", "g", "h_left", "h_right", "friction_correlation"]
        }
      ]
    },
    {
