    {
      "id": "Pump",
      "label": "Pump",
      "category": "Hydraulic",
      "description": "Fixed-pressure-drop or fixed-mass-flow pump. Supports two GUI-accessible modes: scalar fixed dP and fixed mass flow rate.",
      "ports": [
        { "name": "port_in", "type": "FlowPort", "side": "left" },
        { "name": "port_out", "type": "FlowPort", "side": "right" }
      ],
      "parameters": [
        {
          "name": "dP_pump",
          "type": "Real",
          "unit": "Pa",
          "description": "Fixed pressure rise across the pump (used in fixed-dP mode)",
          "required": true,
          "positional": true
        },
        {
          "name": "mdot0",
          "type": "Real",
          "unit": "kg/s",
          "description": "Fixed mass flow rate (used in fixed-mdot mode)",
          "required": true,
          "positional": false
        }
      ],
      "constructorModes": [
        {
          "mode": "fixed-dP",
          "signature": "Pump(dP_pump::Real; name)",
          "parameters": ["dP_pump"]
        },
        {
          "mode": "fixed-mdot",
          "signature": "Pump(; name, mdot0)",
          "parameters": ["mdot0"]
        }
      ]
    },
    {
      "id": "Flapper",
      "label": "Flapper",
      "category": "Hydraulic",
      "description": "Check-valve with smooth opening ramp and MTK continuous event callback. Opens when reference mass flow drops below threshold (loss-of-flow scenarios).",
      "ports": [
        { "name": "port_in", "type": "FlowPort", "side": "left" },
        { "name": "port_out", "type": "FlowPort", "side": "right" }
      ],
      "parameters": [
        {
          "name": "dt",
          "type": "Real",
          "unit": "s",
          "default": 5.0,
          "description": "Opening ramp duration after trigger event",
          "required": false,
          "positional": false
        },
        {
          "name": "threshold",
          "type": "Real",
          "unit": "kg/s",
          "default": 0.01,
          "description": "Mass flow threshold below which the Flapper opens",
          "required": false,
          "positional": false
        },
        {
          "name": "R_closed",
          "type": "Real",
          "unit": "Pa*s/kg",
          "default": 1e8,
          "description": "Hydraulic resistance in closed state",
          "required": false,
          "positional": false
        },
        {
          "name": "R_open",
          "type": "Real",
          "unit": "Pa*s/kg",
          "default": 100.0,
          "description": "Hydraulic resistance in open state",
          "required": false,
          "positional": false
        },
        {
          "name": "use_callback",
          "type": "Bool",
          "default": true,
          "description": "Enable MTK SymbolicContinuousCallback for Flapper latch event",
          "required": false,
          "positional": false
        }
      ],
      "constructorModes": [
        {
          "mode": "default",
          "signature": "Flapper(; name, dt=5.0, threshold=0.01, R_closed=1e8, R_open=100.0, use_callback=true)",
          "parameters": ["dt", "threshold", "R_closed", "R_open", "use_callback"]
        }
      ]
    },
    {
